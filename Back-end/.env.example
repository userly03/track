# Django backend environment example
# Copy this file to Back-end/.env for local backend or Docker usage.

# Security
SECRET_KEY=change-me-to-a-long-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Database
# Docker Compose backend service should use host "db".
DATABASE_URL=postgresql://trackbuild_user:change-me-local-password@db:5432/trackbuild
POSTGRES_DB=trackbuild
POSTGRES_USER=trackbuild_user
POSTGRES_PASSWORD=change-me-local-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# CORS
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Google Identity Services
# This project currently validates Google ID tokens, not an OAuth Authorization Code exchange.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
