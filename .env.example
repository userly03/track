# Docker Compose environment example
# Copy this file to .env at the repository root for local Docker usage.

# PostgreSQL/PostGIS
POSTGRES_DB=trackbuild
POSTGRES_USER=trackbuild_user
POSTGRES_PASSWORD=change-me-local-password
POSTGRES_PORT=5433

# Backend
BACKEND_PORT=8081
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend
FRONTEND_PORT=3000

# Google Identity Services client ID
# Use the same value in Back-end/.env and Front-end/.env.local when running locally.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
